% Headers
\usepackage{fancyhdr}
\fancypagestyle{maintext}{
  \fancyhf{}
  \fancyhead[L]{\nouppercase{\leftmark}}
  \fancyhead[R]{\thepage}
  \renewcommand{\headrulewidth}{0.4pt}
}
\fancypagestyle{appendix}{
  \fancyhf{}
  \fancyhead[L]{\nouppercase{Appendix \leftmark}}
  \fancyhead[R]{\thepage}
  \renewcommand{\headrulewidth}{0.4pt}
}

\fancypagestyle{references}{
  \fancyhf{}
  \fancyhead[L]{References}
  \fancyhead[R]{\thepage}
  \renewcommand{\headrulewidth}{0.4pt}
}
\setlength{\headheight}{15pt}
