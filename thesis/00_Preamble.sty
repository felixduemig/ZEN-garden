% Remove Indents
\setlength\parindent{0pt}

%Global Font Sizes
\AtBeginEnvironment{tabular}{\scriptsize}
\captionsetup[figure]{font=footnotesize}
\captionsetup[table]{font=footnotesize}


% adjustment of page parameters
\usepackage[left=2.5cm, right=2.5cm, top=2.5cm, bottom=2.5cm]{geometry}
%line spacing is set to 1.5
\renewcommand{\baselinestretch}{1.5} 
%space between footnote and text		
\setlength{\footnotesep}{10.0pt}

%Set colors
\definecolor{myblue}{RGB}{14, 48, 96}
\definecolor{myred}{RGB}{166, 38, 35}
\definecolor{myyellow}{RGB}{209, 145, 62}
\definecolor{mylightblue}{RGB}{19, 83, 144}

%Hyper Ref Color
\hypersetup{	
	linkcolor=black,
	colorlinks = true,
	citecolor=black
}

% Force footnote on one page
\interfootnotelinepenalty=10000

% Set section numbering
\setcounter{secnumdepth}{2}

% ---------------------------------------------------------------
% Scaffolding helper macros (drafting only -- remove before final)
% ---------------------------------------------------------------
% Inline TODO note (red, bold). No todonotes package is loaded.
\newcommand{\todo}[1]{{\color{myred}\textbf{[TODO: #1]}}}
% Inline placeholder text (gray) for prose still to be written.
\newcommand{\placeholder}[1]{{\color{gray}\textit{[#1]}}}
% Figure placeholder box of given height (default 5cm) with a caption-like label.
\newcommand{\figplaceholder}[2][5cm]{%
	\begin{center}
		\fbox{\parbox[c][#1][c]{0.9\textwidth}{\centering\color{gray}\itshape [Figure placeholder: #2]}}%
	\end{center}}

